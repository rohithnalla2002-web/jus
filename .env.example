# =============================================================================
# Security & secrets (server-side only - never prefix with VITE_ or commit real
# values to git). Copy this file to `.env` and replace placeholders.
#
# Netlify + Render: see DEPLOYMENT.md (commands, which vars go where - no .env upload).
# =============================================================================

# --- Database (confidential: contains password) ---
# Used by: server/src/db.js, server/scripts/init-db.mjs
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/arcplus

# --- Branch admin login (confidential) ---
# Seeds admin_users on API startup (server/src/index.js) and must match what you type at /admin/login
# unless you change the user in the DB. POST /api/admin/login validates against admin_users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThis_Strong_Password_Immediately
# Set only if you manage this user's password only in the DB (skip overwriting from ADMIN_PASSWORD on each API boot).
# ADMIN_SKIP_ENV_PASSWORD_OVERWRITE=true

# --- Super Admin login (confidential) ---
# Used by: server/src/auth.js - validates POST /api/super-admin/login (username "super" routes there from /admin/login).
# Override defaults before production; keep in sync with optional VITE_LOGIN_HINT_* below if you use those hints.
SUPER_ADMIN_USERNAME=super
SUPER_ADMIN_PASSWORD=super@123

# --- JWT signing key (confidential) ---
# Used by: server/src/auth.js - signs admin session tokens (7-day expiry)
# Generate: openssl rand -hex 32
# Minimum 32 characters; use a long random value in production.
JWT_SECRET=replace_with_openssl_rand_hex_32_minimum_32_chars

# =============================================================================
# Non-secret / operational (optional)
# =============================================================================

# API listen port (default 3001)
# PORT=3001

# Node environment: set to "production" to enforce strong JWT_SECRET
# NODE_ENV=development

# When the Vite dev proxy is not used (e.g. vite preview, static hosting, Netlify),
# set the public API origin so the browser can reach the API (not a secret).
# Netlify: Site settings → Environment variables → VITE_API_URL → redeploy.
# Production API (example): https://goldmind-erp-api.onrender.com  (no trailing slash)
# VITE_API_URL=https://goldmind-erp-api.onrender.com
# VITE_API_URL=http://localhost:3001

# --- Optional: login page hints (client bundle — local dev only) ---
# Mirror the server values above so the /admin/login footer shows the right credentials.
# Do not set these on production frontend builds (they would embed secrets in the JS bundle).
# If you add a key on Netlify etc., give it a real value — an empty value used to break Super Admin routing.
# VITE_LOGIN_HINT_ADMIN_USERNAME=admin
# VITE_LOGIN_HINT_ADMIN_PASSWORD=ChangeThis_Strong_Password_Immediately
# VITE_LOGIN_HINT_SUPER_USERNAME=super
# VITE_LOGIN_HINT_SUPER_PASSWORD=super@123